{
  "name": "analog-studio-vse-core",
  "version": "1.0.0-dev.1",
  "private": true,
  "description": "Browser-based analog IC schematic editor with ERC and deterministic netlist export",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env ANALOG_LOCAL_DEV_ACCOUNT=true WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev -H 127.0.0.1 -p 3002",
    "build": "cross-env ANALOG_LOCAL_DEV_ACCOUNT=false WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env ANALOG_LOCAL_DEV_ACCOUNT=false WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "dev:lan": "cross-env ANALOG_LOCAL_DEV_ACCOUNT=false WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev -H 0.0.0.0 -p 3000",
    "start:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-lan.ps1",
    "deploy:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-lan.ps1",
    "test": "npm run typecheck && npm run build && tsx --test tests/developmentAccount.test.ts tests/netlist.test.ts tests/schematicValidation.test.ts tests/vseCore.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@antv/x6": "^3.1.7",
    "drizzle-orm": "0.45.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.24.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "schematic-symbols": "^0.0.231",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "type": "module"
}
